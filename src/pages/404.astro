---
// Not found, the way the Amstrad said it: TYPE of a file that isn't there.
// The requested path is filled in on the page (it's one static file for
// every missing address).
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="File not found" description="That page does not exist.">
  <section class="nf">
    <div class="nf-screen">
      <span>A:\WZMN\BLOG&gt;TYPE <span id="nf-path">\FILE.TXT</span></span>
      <span>File not found</span>
    </div>
    <p>That page doesn't exist, or it moved. See the <a href={base}>list of posts</a>.</p>
  </section>
  <script>
    // The missing address, as plain text (textContent, never HTML), so
    // nothing in it can run. A malformed %-escape keeps the raw path; a very
    // long one is cut.
    const el = document.getElementById('nf-path');
    let path = location.pathname;
    try { path = decodeURIComponent(path); } catch (e) {}
    let rest = path.replace(/^\/blog\/?/, '').replace(/\/$/, '');
    if (rest.length > 120) rest = rest.slice(0, 120) + '...';
    if (el && rest) el.textContent = '\\' + rest.toUpperCase().replace(/\//g, '\\');
  </script>
</BaseLayout>
